INPUT_FILE=data/orders_huge_mixed_quality.csv
SMALL_SAMPLE_FILE=data/orders_small_sample.csv

SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=5000
SAMPLE_ROWS=100000

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=midterm_data_pipeline
RAW_COLLECTION=orders_raw
VALIDATED_COLLECTION=orders_validated
QUARANTINE_COLLECTION=orders_quarantine

SPARK_MASTER=local[*]
SPARK_APP_NAME=MidtermDataPipeline
